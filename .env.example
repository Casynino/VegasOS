# PostgreSQL connection the app uses (Neon in production: the POOLED url — host has "-pooler")
DATABASE_URL="postgresql://user:password@host:5432/vegas_hotel"
# Neon in production: the DIRECT url (host without "-pooler") — used by migrations during the build.
# Leave empty locally.
DIRECT_URL=""
# Public address of the site (links in WhatsApp reports), e.g. https://vegasluxuryhotel.co.tz
NEXT_PUBLIC_SITE_URL=""
# Random 32+ char string
SESSION_SECRET=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
# CallMeBot WhatsApp API key for the Boss's phone (see /staff/settings)
CALLMEBOT_API_KEY=""
